# TEEVR AI environment configuration
# Copy to .env and fill in for cloud deployment. Never commit real secrets.

# --- Mode ---
TEEVRA_MODE=local          # local | cloud
GCP_PROJECT_ID=teevra-ai-demo
GCP_REGION=asia-south1     # Telangana demo; use a supported region for Vertex AI if needed

# --- Authentication (Firebase in cloud mode) ---
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# --- Vertex AI / Gemini ---
VERTEX_AI_LOCATION=asia-south1
GEMINI_TEXT_MODEL=gemini-1.5-flash-002
GEMINI_LIVE_MODEL=gemini-1.5-flash-native  # set only if Live streaming is enabled in your project/region

# --- Pub/Sub / Eventarc ---
PUBSUB_TOPIC_FAULTS=teevra-machine-faults
PUBSUB_TOPIC_HEAT=teevra-heat-readings
PUBSUB_TOPIC_SCHEDULE=teevra-schedule-updates

# --- Firestore / BigQuery ---
FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=teevra_analytics

# --- Secret Manager (deployed secrets only) ---
# GOOGLE_APPLICATION_CREDENTIALS is NOT used; workload identity in Cloud Run.

# --- Demo / simulation ---
DEMO_TZ=Asia/Kolkata
DEMO_START=2026-10-17T06:00:00+05:30
SOLVER_TIME_LIMIT_SECONDS=30

# --- Agent endpoints (local docker compose) ---
RECOVERY_AGENT_URL=http://recovery-agent:8072
HEAT_GUARDIAN_URL=http://heat-guardian-agent:8071
API_GATEWAY_URL=http://api-gateway:8080
